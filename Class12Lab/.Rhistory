install.packages(BiocGenerics)
install.packages("BiocGenerics")
library(BiocManager)
library(DESeq2)
counts <- read.csv("airway_scaledcounts.csv", row.names=1)
metadata <-  read.csv("airway_metadata.csv")
nrow(counts)
ncol(counts)
sum(metadata$dex=="control")
control <- metadata[metadata[,"dex"]=="control",]
control.counts <- counts[ ,control$id]
control.mean <- rowSums( control.counts )/4
head(control.mean)
treated <- metadata[metadata[,"dex"]=="treated",]
treated.counts <- counts[ ,treated$id]
treated.mean <- rowSums( treated.counts )/4
head(treated.mean)
meancounts <- data.frame(control.mean, treated.mean)
plot(meancounts[,1],meancounts[,2], xlab="Control", ylab="Treated")
plot(log(meancounts[,1]),log(meancounts[,2]), xlab="Control", ylab="Treated", main='Log-Log Plot')
zero.vals <- which(meancounts[,1:2]==0, arr.ind=TRUE)
to.rm <- unique(zero.vals[,1])
mygenes <- meancounts[-to.rm,]
head(mygenes)
up.ind <- mygenes$log2fc > 2
down.ind <- mygenes$log2fc < (-2)
library(BiocManager)
library(DESeq2)
DESeqDataSetFromMatrix(counts, metadata, ~dex)
dds <- DESeqDataSetFromMatrix(counts, metadata, ~dex)
dds <- DESeq(dds)
res <- results(dds)
res <- results(dds)
head(res)
plot(res$log2FoldChange)
plot(res$log2FoldChange, res$padj)
plot(res$log2FoldChange, log(res$padj))
plot(res$log2FoldChange, -log(res$padj))
plot(res$log2FoldChange, -log(res$padj))
abline(v=-2, col="red")
plot(res$log2FoldChange, -log(res$padj))
abline(v=c(-2, 2), col="red")
plot(res$log2FoldChange, -log(res$padj))
abline(v=c(-2, 2), col="red")
abline(h=-log(0.05), col="red")
write.csv(res, file="myresults.csv")
ggplot(res) + aes(log2FoldChange, -log(padj)) +geom_point()
library(ggplot2)
ggplot(res) + aes(log2FoldChange, -log(padj)) +geom_point()
library(ggplot2)
mycols <- rep("grey", nrow(res))
mycols[abs(res$log2FoldChange)>2] <- "blue"
ggplot(res) + aes(log2FoldChange, -log(padj)) +geom_point()
library(ggplot2)
mycols <- rep("grey", nrow(res))
mycols[abs(res$log2FoldChange)>2] <- "blue"
ggplot(res) + aes(log2FoldChange, -log(padj)) +geom_point(col=mycols)
library(ggplot2)
mycols <- rep("grey", nrow(res))
mycols[abs(res$log2FoldChange)>2] <- "blue"
mycols[res$padk >- 0.05] <- "grey"
ggplot(res) + aes(log2FoldChange, -log(padj)) +geom_point(col=mycols)
library(BiocManager)
library(DESeq2)
counts <- read.csv("airway_scaledcounts.csv", row.names=1)
metadata <-  read.csv("airway_metadata.csv")
nrow(counts)
ncol(counts)
sum(metadata$dex=="control")
control <- metadata[metadata[,"dex"]=="control",]
control.counts <- counts[ ,control$id]
control.mean <- rowSums( control.counts )/4
head(control.mean)
treated <- metadata[metadata[,"dex"]=="treated",]
treated.counts <- counts[ ,treated$id]
treated.mean <- rowSums( treated.counts )/4
head(treated.mean)
meancounts <- data.frame(control.mean, treated.mean)
plot(meancounts[,1],meancounts[,2], xlab="Control", ylab="Treated")
plot(log(meancounts[,1]),log(meancounts[,2]), xlab="Control", ylab="Treated", main='Log-Log Plot')
meancounts$log2fc <- log2(meancounts[,"treated.mean"]/meancounts[,"control.mean"])
head(meancounts)
zero.vals <- which(meancounts[,1:2]==0, arr.ind=TRUE)
to.rm <- unique(zero.vals[,1])
mygenes <- meancounts[-to.rm,]
head(mygenes)
up.ind <- mygenes$log2fc > 2
down.ind <- mygenes$log2fc < (-2)
dds <- DESeqDataSetFromMatrix(counts, metadata, ~dex)
dds <- DESeq(dds)
res <- results(dds)
head(res)
plot(res$log2FoldChange, -log(res$padj))
abline(v=c(-2, 2), col="red")
abline(h=-log(0.05), col="red")
write.csv(res, file="myresults.csv")
library(ggplot2)
mycols <- rep("grey", nrow(res))
mycols[abs(res$log2FoldChange)>2] <- "blue"
mycols[res$padk >- 0.05] <- "grey"
ggplot(res) + aes(log2FoldChange, -log(padj)) +geom_point(col=mycols)
library("AnnotationDbi")
install.packages("AnnotationDbi")
BiocManager::install("AnnotationDbi")
BiocManager::install("org.Hs.eg.db")
library("AnnotationDbi")
library("org.Hs.eg.db")
res$symbol <- mapIds(org.Hs.eg.db,
keys=row.names(res), # Our genenames
keytype="ENSEMBL",        # The format of our genenames
column="SYMBOL",          # The new format we want to add
multiVals="first")
head(res$symbol)
res$genename <- mapIds(org.Hs.eg.db,
keys=row.names(res), # Our genenames
keytype="ENSEMBL",        # The format of our genenames
column="GENENAME",          # The new format we want to add
multiVals="first")
res$entrezid <- mapIds(org.Hs.eg.db,
keys=row.names(res), # Our genenames
keytype="ENSEMBL",        # The format of our genenames
column="ENTREZID",          # The new format we want to add
multiVals="first")
BiocManager::install( c("pathview", "gage", "gageData") )
library(gage)
library(gageData)
foldchanges <- res$log2FoldChange
library(gage)
library(gageData)
library(pathview)
foldchanges <- res$log2FoldChange
keggres = gage(foldchanges, gsets=kegg.sets.hs)
foldchanges <- res$log2FoldChange
data(kegg.sets.hs)
keggres = gage(foldchanges, gsets=kegg.sets.hs)
pathview(gene.data=foldchanges, pathway.id="hsa05310")
foldchanges <- res$log2FoldChange
data(kegg.sets.hs)
names(foldchanges) = res$entrezid
keggres = gage(foldchanges, gsets=kegg.sets.hs)
pathview(gene.data=foldchanges, pathway.id="hsa05310")
